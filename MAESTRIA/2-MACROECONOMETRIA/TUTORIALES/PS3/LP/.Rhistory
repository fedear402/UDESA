library(readr)
library(seasonal)
# Data ####
X <- read_csv("Data_LP.csv")
X <- ts(X, start = c(2004, 1), frequency = 4)
X <- window(X, end = c(2019, 4))
# Extract and properly create time series objects
GC <- ts(X[, "RGC"], start = c(2004, 1), frequency = 4)
GC <- window(GC, end = c(2019, 4))
# Create GS properly as a time series
NGS <- ts(X[, "NGS"], start = c(2004, 1), frequency = 4)
P <- ts(X[, "P"], start = c(2004, 1), frequency = 4)
GS <- ts(NGS / P, start = c(2004, 1), frequency = 4)
GS <- window(GS, end = c(2019, 4))
Y <- ts(X[, "Y"], start = c(2004, 1), frequency = 4)
Y <- window(Y, end = c(2019, 4))
# Check if GS is properly formatted
print(class(GS))
print(frequency(GS))
print(tsp(GS))
# Try seasonal adjustment
seas.adj <- seas(GS)
plot(GS, type = "l")
plot(GS, type = "b")
plot(GS, type = "a")
plot(GS, type = "c")
plot(GS, type = "d")
plot(GS, type = "e")
plot(GS, type = "f")
plot(GS, type = "g")
plot(GS, type = "h")
plot(GS, type = "i")
plot(GS, type = "j")
plot(GS, type = "candle")
acf(GS, na.action = na.pass)
